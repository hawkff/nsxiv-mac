#!/bin/sh
# nsxiv-rifle for nsxiv-mac: open one image and browse its whole directory,
# starting at that image. Multiple arguments open as-is.

[ $# -eq 0 ] && exit 2

if [ $# -gt 1 ] || [ -d "$1" ]; then
    exec nsxiv-mac -- "$@"
fi

# from the image's directory, which a key-handler then has as its own; the viewer lists it
# itself, in its own order, and starts at the image
cd "$(dirname -- "$1")" || exec nsxiv-mac -- "$1"
exec nsxiv-mac --start-file "$(basename -- "$1")" -- .
